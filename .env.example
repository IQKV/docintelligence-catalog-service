# CatalogService Environment Variables Template
# Copy this file to .env.local, .env.uat, or .env.prd and configure values

# =============================================================================
# Database Configuration
# =============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=catalogservice
DB_USERNAME=svc_catalog_dba
DB_PASSWORD=svc_catalog_dba

# =============================================================================
# RabbitMQ Messaging Configuration
# =============================================================================
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=svc_catalog_rmq
RABBITMQ_PASSWORD=svc_catalog_rmq

# =============================================================================
# Object Storage Configuration (MinIO / S3)
# =============================================================================
OBJECTSTORAGE_ENDPOINT=http://localhost:9000
OBJECTSTORAGE_PUBLIC_ENDPOINT=
OBJECTSTORAGE_ACCESS_KEY=iqkv
OBJECTSTORAGE_SECRET_KEY=iqkv_password
OBJECTSTORAGE_BUCKET_NAME=catalog-assets
OBJECTSTORAGE_REGION=us-east-1
OBJECTSTORAGE_SSL=false

# =============================================================================
# Spring Profile Configuration
# =============================================================================
SPRING_PROFILES_ACTIVE=local

# =============================================================================
# Messaging Toggle
# Injected by Helm configmap in deployed environments (sit/uat/prd).
# Set to true here only if running the full stack locally via compose.container.yaml.
# Maps to: iqkv.messaging.rabbitmq.enabled
# =============================================================================
MESSAGING_ENABLED=false

# =============================================================================
# Platform Rollout Mode
# Injected by Helm configmap in deployed environments.
# Valid values: MULTI_TENANT | SINGLE_TENANT
# Maps to: iqkv.platform.rollout-mode
# =============================================================================
ROLLOUT_MODE=MULTI_TENANT

# =============================================================================
# JWT / Authentication
# In deployed (K8s) environments, set JWT_JWKS_URI so each service fetches the
# IAM public key dynamically — no mounted key copies, transparent key rotation.
# Leave JWT_JWKS_URI unset for local dev; the classpath PEM fallback is used.
# =============================================================================
# JWT_JWKS_URI=http://foundation-iam-service/.well-known/jwks.json
# JWT_PUBLIC_KEY_PATH=classpath:keys/public.pem


POSTGRES_DB=catalogservice
POSTGRES_USER=svc_catalog_dba
POSTGRES_PASSWORD=svc_catalog_dba

# =============================================================================
# Ollama / AI Configuration
# =============================================================================
SPRING_AI_OLLAMA_BASE_URL=http://localhost:11434
SPRING_AI_OLLAMA_CHAT_OPTIONS_MODEL=llama3.2
# Embedding model for semantic search — must be pulled in Ollama first:
#   docker exec foundation-catalog-ollama-dev ollama pull nomic-embed-text
SPRING_AI_OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# =============================================================================
# Semantic Search / Vector Embedding Backfill
# Set SEMANTIC_SEARCH_BACKFILL_ENABLED=true once nomic-embed-text is available.
# The backfill scheduler embeds venues where embedding IS NULL, 20 per cycle.
# =============================================================================
SEMANTIC_SEARCH_BACKFILL_ENABLED=false
SEMANTIC_SEARCH_BACKFILL_INTERVAL=PT5M
