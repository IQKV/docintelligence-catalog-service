<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.33.xsd">

    <!-- Tenant venue documents (venue decks) — stores all file info captured during the
         two-phase presigned upload. Lives in the t_{tenantKey} schema (search_path is set
         by TenantLiquibaseRunner before these changesets run, so no schemaName is set).

         A row is created at confirm time, after the client has PUT the file to MinIO, with
         status UPLOADED. The status later transitions PARSING -> EXTRACTED, or FAILED, as
         the processing worker picks the document up. The object_key is tenant-scoped
         (embeds the tenantKey and document id) so confirm can validate ownership by prefix.
         No venue_id is carried here: the upload flow is flat (/initiate -> /{id}/confirm),
         so the document is standalone; the link to a tenant venue is added later when the
         association flow is built. -->

    <changeSet id="20261109120001-create-venue-documents" author="iqkv">

        <createTable tableName="venue_documents">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <!-- Original file name as uploaded. -->
            <column name="file_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="content_type" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="size_bytes" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <!-- Tenant-scoped S3/MinIO object key (embeds tenantKey + documentId). -->
            <column name="object_key" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <!-- Upload lifecycle: UPLOADED -> PARSING -> EXTRACTED | FAILED.
                 Plain VARCHAR (no CHECK) to match the master_venue convention; the service
                 layer enforces valid transitions. -->
            <column name="status" type="VARCHAR(20)" defaultValue="UPLOADED">
                <constraints nullable="false"/>
            </column>
            <!-- IAM user id of the uploader. -->
            <column name="uploaded_by" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="venue_documents" indexName="idx_venue_documents_uploaded_by">
            <column name="uploaded_by"/>
        </createIndex>
        <createIndex tableName="venue_documents" indexName="idx_venue_documents_status">
            <column name="status"/>
        </createIndex>

        <rollback>
            <dropIndex tableName="venue_documents" indexName="idx_venue_documents_status"/>
            <dropIndex tableName="venue_documents" indexName="idx_venue_documents_uploaded_by"/>
            <dropTable tableName="venue_documents"/>
        </rollback>

    </changeSet>

</databaseChangeLog>
