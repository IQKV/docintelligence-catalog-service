<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.33.xsd">

    <!-- Denormalise the primary photo URL onto venues to avoid a join to venue_assets on every
         list/detail read — the tenant counterpart of primary_photo_url on public.master_venue.
         Lives in the t_{tenantKey} schema (search_path is set by TenantLiquibaseRunner before
         these changesets run, so no schemaName is set).

         No backfill: venue_assets is created in the same release and starts empty, and a tenant
         asset carries no source URL to derive from. Rows keep NULL until a writer sets it. -->

    <changeSet id="20261109150001-add-venue-primary-photo-url" author="iqkv">

        <addColumn tableName="venues">
            <column name="primary_photo_url" type="TEXT"/>
        </addColumn>

        <rollback>
            <dropColumn tableName="venues" columnName="primary_photo_url"/>
        </rollback>

    </changeSet>

</databaseChangeLog>
