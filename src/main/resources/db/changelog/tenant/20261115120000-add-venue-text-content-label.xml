<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.33.xsd">

    <!-- Human-readable name of one venue_text_contents row — a title, or the original file name
         the text was extracted from. Optional; NULL when the source has no name, which is the case
         for every row created before this column existed.

         Lives in the t_{tenantKey} schema (search_path is set by TenantLiquibaseRunner before
         these changesets run, so no schemaName is set on the statements below). -->

    <changeSet id="20261115120000-add-venue-text-content-label" author="iqkv">

        <addColumn tableName="venue_text_contents">
            <column name="label" type="VARCHAR(512)"/>
        </addColumn>

        <rollback>
            <dropColumn tableName="venue_text_contents" columnName="label"/>
        </rollback>

    </changeSet>

</databaseChangeLog>
