<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.33.xsd">

    <!-- Denormalise the primary photo URL onto master_venue to avoid a
         join to master_venue_asset on every list/detail read.
         Set by the ingestion worker from the first asset (display_order=0). -->
    <changeSet id="20261029120000-add-master-venue-primary-photo-url" author="iqkv">

        <addColumn tableName="master_venue" schemaName="public">
            <column name="primary_photo_url" type="TEXT"/>
        </addColumn>

        <!-- Backfill from the asset with the lowest display_order for each venue.
             Rows with no assets keep NULL, which is the correct default. -->
        <sql>
            UPDATE public.master_venue mv
            SET primary_photo_url = a.source_url
            FROM (
                SELECT DISTINCT ON (master_venue_id)
                    master_venue_id,
                    source_url
                FROM public.master_venue_asset
                WHERE source_url IS NOT NULL
                ORDER BY master_venue_id, display_order, id
            ) a
            WHERE mv.id = a.master_venue_id;
        </sql>

        <rollback>
            <dropColumn tableName="master_venue" schemaName="public" columnName="primary_photo_url"/>
        </rollback>

    </changeSet>

</databaseChangeLog>
